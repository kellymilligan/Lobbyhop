{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{NAME}}",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  // Your built game (e.g. `vite build` → dist/) is served as static assets;
  // /rooms/<code> goes to that room's Durable Object.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rooms/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects run on the Workers Free plan. Never edit an
  // applied migration; add a new tag instead.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
